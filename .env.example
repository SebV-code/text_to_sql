# Clé OpenRouter : ne jamais committer une vraie valeur.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_URL=http://localhost:8501
OPENROUTER_APP_NAME=Text-to-SQL local

# Obligatoire : URL de la base NeonDB existante.
DATABASE_URL=
SQL_MAX_ROWS=100
DB_STATEMENT_TIMEOUT_MS=5000
